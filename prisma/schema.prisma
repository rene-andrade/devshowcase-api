generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  bio       String?
  githubUrl String
  email     String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id           Int          @id @default(autoincrement())
  title        String
  description  String
  repository   String
  profileId    String       @db.Uuid
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  technologies Technology[]
  feedbacks    Feedback[]
  createdAt    DateTime     @default(now())
}

model Technology {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  projects Project[]
}

model Feedback {
  id        Int      @id @default(autoincrement())
  author    String
  comment   String
  rating    Int
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
